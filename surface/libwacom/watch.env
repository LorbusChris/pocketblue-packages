# Rebuild triggers for the libwacom COPR build. Nothing reads these values:
# Renovate bumping one -- and the merge touching this directory -- is what
# retriggers the build through the path-filtered COPR webhook.
#
# Fedora's libwacom version: the SRPM step pulls Fedora's current rawhide
# spec, so a bump here simply means "rebuild against it" (and keeps our
# timestamp.surface release version-winning over the new stock build).
# renovate: datasource=custom.fedora-mdapi depName=libwacom
FEDORA_LIBWACOM_VERSION=2.20.0
#
# The linux-surface patch source. On a bump, regenerate
# 0001-surface-virt-mei-bus-and-tablets.patch from the ipts branch (see the
# patch header) before merging.
# renovate: datasource=git-refs depName=https://github.com/linux-surface/libwacom branch=ipts
LIBWACOM_IPTS_COMMIT=87f8269ef76e7ca8b4cf9e106fcee04944c76c0e
