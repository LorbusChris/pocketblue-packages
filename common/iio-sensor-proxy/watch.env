# Rebuild trigger: the SRPM step pulls Fedora's current rawhide spec, so a
# bump of Fedora's own version here just means "rebuild against it" --
# Renovate bumping the line (and the merge touching this directory) is what
# retriggers the build through the path-filtered COPR webhook.
# renovate: datasource=custom.fedora-mdapi depName=iio-sensor-proxy
FEDORA_IIO_SENSOR_PROXY_VERSION=3.9
